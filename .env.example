# Existing durable PostgreSQL connection (set in Vercel; never commit its value).
POSTGRES_URL=
# A Resend sending-only key restricted to the verified sending domain.
RESEND_API_KEY=
CHECKIN_EMAIL_FROM=The Music Makeover <checkin@mail.themusicmakeover.com>
# Optional stable signing key. Hosted admin access always also checks stored sessions.
ADMIN_SESSION_SECRET=

# Peace Promise: leave checkout disabled until product, legal copy and delivery pass review.
STRIPE_SECRET_KEY=
PEACE_STRIPE_WEBHOOK_SECRET=
PEACE_STRIPE_PAYMENT_LINK_ID=
PEACE_STRIPE_PRICE_ID=
PEACE_STRIPE_LIVE=false
PEACE_EMAIL_FROM=Ashley Miller <ashley@rootedwomencollective.com>
PEACE_SUPPORT_EMAIL=ashley@rootedwomencollective.com
# Generated by scripts/package-peace-workbooks.js in ignored .env.local.
# Add securely to Vercel; never commit the key or unencrypted workbooks.
PEACE_WORKBOOK_KEY=
# Rooted Letter newsletter (separate from paid product delivery)
ROOTED_RESEND_API_KEY=
ROOTED_SEGMENT_ID=d044762b-def8-4d52-874e-39f3835b1685
ROOTED_SITE_URL=https://www.themusicmakeover.com

# Dedicated sending-only key for rootedwomencollective.com purchase emails.
PEACE_RESEND_API_KEY=
